# LitKG-Integrate Environment Variables Template
# Copy this file to .env and fill in your actual values

# PubMed API (Required for literature processing)
PUBMED_EMAIL=your-email@domain.com
PUBMED_API_KEY=your-pubmed-api-key-here

# Local LLM via Ollama (default provider - no API key needed)
# Defaults live in config/config.yaml under `llm.ollama`; these override them.
OLLAMA_HOST=http://localhost:11434
LITKG_OLLAMA_MODEL=qwen3:8b
LITKG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# AI API Keys (optional - cloud fallback behind local Ollama)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# UMLS API (Optional but recommended for better ontology mapping)
UMLS_API_KEY=your-umls-api-key-here

# Database URLs (Optional - for advanced usage)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

MONGODB_URL=mongodb://localhost:27017/litkg

# Weights & Biases (Optional - for experiment tracking)
WANDB_API_KEY=your-wandb-api-key-here
WANDB_PROJECT=litkg-integrate

# Development settings
LITKG_LOG_LEVEL=INFO
LITKG_CACHE_DIR=cache
LITKG_DATA_DIR=data